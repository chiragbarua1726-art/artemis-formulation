datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MANAGER
  MR
}

enum TourStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String      @id @default(uuid())
  name          String
  email         String      @unique
  passwordHash  String
  role          Role
  phone         String?
  region        String?
  managerId     String?
  manager       User?       @relation("ManagerToMR", fields: [managerId], references: [id], onDelete: SetNull)
  reports       User[]      @relation("ManagerToMR")
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  visits        Visit[]
  tourPlans     TourPlan[]
  expenses      Expense[]
  createdDoctors Doctor[]       @relation("DoctorCreatedBy")
  chemists      Chemist[]
  povOrders     PovOrder[]
  attendance    Attendance[]

  @@index([role])
  @@index([managerId])
  @@index([region])
}

model Doctor {
  id           String      @id @default(uuid())
  name         String
  hospitalName String
  address      String
  latitude     Float?
  longitude    Float?
  phone        String?
  active       Boolean     @default(true)
  status       String      @default("APPROVED")
  createdById  String?
  createdBy    User?       @relation("DoctorCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedBy   String?
  reviewNote   String?
  reviewedAt   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  visits       Visit[]

  @@index([status])
  @@index([createdById])
}

model Product {
  id          String               @id @default(uuid())
  name        String
  description String?
  sku         String               @unique
  category    String?
  unitPrice   Float?               @default(0.0)
  active      Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  discussions ProductDiscussion[]

  @@index([sku])
  @@index([active])
}

model Visit {
  id                String              @id @default(uuid())
  mrId              String
  mr                User                @relation(fields: [mrId], references: [id], onDelete: Cascade)
  doctorId          String
  doctor            Doctor              @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  checkInTime       DateTime            @default(now())
  checkOutTime      DateTime?
  checkInLat        Float
  checkInLng        Float
  visitDate         DateTime?
  visitPurpose      String?
  notes             String?
  nextVisitDate     DateTime?
  productsDiscussed ProductDiscussion[]
  samplesGiven      Json?               // [{ productId, productName, quantity }]
  feedback          String?
  photoUrl          String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([mrId])
  @@index([doctorId])
  @@index([checkInTime])
}

model ProductDiscussion {
  id        String   @id @default(uuid())
  visitId   String
  visit     Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  notes     String?
  quantity  Int?
  value     Float?
  createdAt DateTime @default(now())

  @@index([visitId])
  @@index([productId])
}

model TourPlan {
  id          String     @id @default(uuid())
  mrId        String
  mr          User       @relation(fields: [mrId], references: [id], onDelete: Cascade)
  weekStart   DateTime
  weekEnd     DateTime
  planDetails Json       // [{ date, doctorIds[], area }]
  status      TourStatus @default(PENDING)
  reviewedBy  String?
  reviewNote  String?
  reviewedAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([mrId])
  @@index([status])
  @@index([weekStart])
}

model Expense {
  id          String        @id @default(uuid())
  mrId        String
  mr          User          @relation(fields: [mrId], references: [id], onDelete: Cascade)
  category    String        // travel, food, lodging, misc
  amount      Decimal
  receiptUrl  String?
  description String?
  status      ExpenseStatus @default(PENDING)
  reviewedBy  String?
  reviewNote  String?
  reviewedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([mrId])
  @@index([status])
  @@index([category])
}

model Chemist {
  id         String   @id @default(uuid())
  name       String
  address    String
  phone      String?
  notes      String?
  mrId       String
  mr         User     @relation(fields: [mrId], references: [id], onDelete: Cascade)
  status     String   @default("PENDING")
  reviewedBy String?
  reviewNote String?
  reviewedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([mrId])
  @@index([status])
  @@index([name])
}

model PovOrder {
  id           String   @id @default(uuid())
  customerName String
  productName  String
  productSku   String?
  quantity     Int
  notes        String?
  mrId         String
  mr           User     @relation(fields: [mrId], references: [id], onDelete: Cascade)
  status       String   @default("PENDING")
  reviewedBy   String?
  reviewNote   String?
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([mrId])
  @@index([status])
  @@index([createdAt])
}

model Attendance {
  id             String   @id @default(uuid())
  mrId           String
  mr             User     @relation(fields: [mrId], references: [id], onDelete: Cascade)
  attendanceDate DateTime
  checkInTime    DateTime @default(now())
  checkOutTime   DateTime?
  checkInLat     Float?
  checkInLng     Float?
  checkOutLat    Float?
  checkOutLng    Float?
  notes          String?
  status         String   @default("PENDING")
  reviewedBy     String?
  reviewNote     String?
  reviewedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([mrId])
  @@index([attendanceDate])
  @@index([status])
}
