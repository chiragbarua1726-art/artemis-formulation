# Server Configuration
PORT=5001
NODE_ENV=development

# Database Configuration
# Local SQLite:
DATABASE_URL="file:./dev.db"
# Or PostgreSQL (Neon / Supabase / Railway / Render):
# DATABASE_URL="postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Authentication
JWT_SECRET="replace-with-a-secure-random-32-byte-hex-string"
JWT_REFRESH_SECRET="replace-with-a-second-secure-random-32-byte-hex-string"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="http://localhost:5173"

# Google Identity Services (optional; required for Google sign-in)
GOOGLE_CLIENT_ID="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"

# Email confirmation (SMTP). Without SMTP in development, the API logs the link.
APP_URL="http://localhost:5173"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Artemis Formulation <no-reply@example.com>"
