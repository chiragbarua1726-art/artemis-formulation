# Required secrets. Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-second-long-random-secret

# Public URL used in confirmation emails and OAuth configuration.
APP_URL=https://your-domain.example
CORS_ORIGIN=https://your-domain.example

# Host port for the web container.
WEB_PORT=8080
API_UPSTREAM=http://api:5001

# Optional Google Identity Services client ID.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Optional SMTP configuration for registration confirmation emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Artemis <no-reply@your-domain.example>
